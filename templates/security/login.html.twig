{% extends 'base.html.twig' %}

{% block body %}
    <div class="container my-4">
        <div class="registrationForm">
            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        Vous être connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                    </div>
                {% endif %}

                <h1 class="h3 mb-3 font-weight-normal">Entrez vos identifiants de connexion</h1>

                <br><br>
                
                <input type="text" value="{{ last_username }}" name="username" id="inputUsername" class="form-control rf_field" autocomplete="username" placeholder="Nom d'utilisateur" required autofocus>

                <br>

                <input type="password" name="password" id="inputPassword" class="form-control rf_field" autocomplete="current-password" placeholder="Mot de passe" required>

                <br>

                <a class="nav-link" id="rf_connection" href="{{ path('app_forgotten_password') }}">Mot de passe oublié ?</a>

                <input type="hidden" name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                <br>

                <div class="checkbox mb-3">
                    <label>
                        <input type="checkbox" name="_remember_me"> Se souvenir de moi
                    </label>
                </div>

                <button class="btn btn-lg btn-primary" type="submit">
                    Se connecter
                </button>
            </form>

            <br>

            <a class="nav-link" id="rf_connection" href="{{ path('app_register') }}">Pas encore inscrit ? Créez un compte !</a>
        </div>
    </div>
{% endblock %}
